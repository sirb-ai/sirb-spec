{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirb.ai/schemas/v1alpha1/workflow.schema.json",
  "title": "Sirb Workflow",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "Workflow"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "steps"
      ],
      "properties": {
        "description": {
          "$ref": "common.schema.json#/$defs/description"
        },
        "trigger": {
          "$ref": "#/$defs/trigger"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/step"
          }
        },
        "outputs": {
          "$ref": "#/$defs/valueMap"
        }
      }
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type"
      ],
      "properties": {
        "type": {
          "enum": [
            "manual",
            "schedule",
            "webhook",
            "event"
          ]
        },
        "schedule": {
          "$ref": "common.schema.json#/$defs/cron"
        },
        "event": {
          "type": "string",
          "pattern": "^[a-z0-9.-]{1,128}(?![\\s\\S])"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "schedule"
              }
            }
          },
          "then": {
            "required": [
              "schedule"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "event"
              }
            }
          },
          "then": {
            "required": [
              "event"
            ]
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "agent": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "tool": {
          "$ref": "common.schema.json#/$defs/ref"
        },
        "dependsOn": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "common.schema.json#/$defs/name"
          },
          "maxItems": 200
        },
        "input": {
          "$ref": "#/$defs/valueMap"
        },
        "when": {
          "type": "string",
          "maxLength": 1024,
          "$ref": "common.schema.json#/$defs/text"
        },
        "retry": {
          "$ref": "common.schema.json#/$defs/retry"
        },
        "timeoutSeconds": {
          "$ref": "common.schema.json#/$defs/seconds"
        }
      },
      "oneOf": [
        {
          "required": [
            "agent"
          ]
        },
        {
          "required": [
            "tool"
          ]
        }
      ]
    },
    "valueMap": {
      "description": "Step inputs or workflow outputs. Values are plain scalars or, for secrets, a secretRef. Keys that name a secret (apiKey, token, password, ...) must use a secretRef.",
      "type": "object",
      "maxProperties": 64,
      "propertyNames": {
        "pattern": "^[a-zA-Z_][a-zA-Z0-9_]{0,63}(?![\\s\\S])"
      },
      "patternProperties": {
        "([Aa][Pp][Ii]_?[Kk][Ee][Yy]|[Tt][Oo][Kk][Ee][Nn]|[Ss][Ee][Cc][Rr][Ee][Tt]|[Pp][Aa][Ss][Ss][Ww]|[Pp][Ww][Dd]|[Cc][Rr][Ee][Dd][Ee][Nn][Tt][Ii][Aa][Ll]|[Pp][Rr][Ii][Vv][Aa][Tt][Ee]_?[Kk][Ee][Yy]|[Aa][Uu][Tt][Hh])": {
          "$ref": "common.schema.json#/$defs/secretSource"
        }
      },
      "additionalProperties": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 8192,
            "$ref": "common.schema.json#/$defs/text",
            "not": {
              "$ref": "common.schema.json#/$defs/authSchemePattern"
            }
          },
          {
            "type": "number",
            "minimum": -9007199254740991,
            "maximum": 9007199254740991
          },
          {
            "type": "boolean"
          },
          {
            "$ref": "common.schema.json#/$defs/secretSource"
          }
        ]
      }
    }
  }
}
