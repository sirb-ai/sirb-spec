{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirb.ai/schemas/v1alpha1/policy.schema.json",
  "title": "Sirb Policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "$ref": "common.schema.json#/$defs/apiVersion"
    },
    "kind": {
      "const": "Policy"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata"
    },
    "spec": {
      "$ref": "#/$defs/spec"
    }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rules"
      ],
      "properties": {
        "description": {
          "$ref": "common.schema.json#/$defs/description"
        },
        "enforcement": {
          "enum": [
            "enforce",
            "audit",
            "disabled"
          ],
          "default": "enforce"
        },
        "rules": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/rule"
          }
        },
        "limits": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "maxToolCallsPerRun": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxTokensPerRun": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            },
            "maxRunSeconds": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2147483647
            }
          }
        }
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "target",
        "effect"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/name"
        },
        "description": {
          "$ref": "common.schema.json#/$defs/description"
        },
        "target": {
          "enum": [
            "tool-call",
            "model-input",
            "model-output",
            "memory-write",
            "knowledge-retrieval"
          ]
        },
        "effect": {
          "enum": [
            "allow",
            "deny",
            "require-approval",
            "redact",
            "log"
          ]
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "approval": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approvers"
          ],
          "properties": {
            "approvers": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "maxItems": 50,
              "items": {
                "type": "string",
                "pattern": "^(user|group):[A-Za-z0-9._@-]{1,200}(?![\\s\\S])"
              }
            },
            "timeoutSeconds": {
              "$ref": "common.schema.json#/$defs/seconds"
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "effect": {
                "const": "require-approval"
              }
            }
          },
          "then": {
            "required": [
              "approval"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "effect": {
                "const": "redact"
              }
            }
          },
          "then": {
            "required": [
              "match"
            ],
            "properties": {
              "match": {
                "type": "object",
                "anyOf": [
                  {
                    "required": [
                      "pii"
                    ]
                  },
                  {
                    "required": [
                      "patterns"
                    ]
                  }
                ]
              }
            }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "tools": {
          "$ref": "common.schema.json#/$defs/refList"
        },
        "pii": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "email",
              "phone",
              "credit-card",
              "iban",
              "national-id",
              "credential"
            ]
          }
        },
        "patterns": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": {
            "$ref": "common.schema.json#/$defs/safeRegex"
          }
        },
        "domains": {
          "type": "array",
          "uniqueItems": true,
          "maxItems": 200,
          "items": {
            "type": "string",
            "format": "hostname"
          }
        },
        "caseInsensitive": {
          "type": "boolean",
          "default": false
        }
      }
    }
  }
}
