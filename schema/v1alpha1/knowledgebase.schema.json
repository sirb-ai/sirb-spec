{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirb.ai/schemas/v1alpha1/knowledgebase.schema.json",
  "title": "Sirb KnowledgeBase",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "KnowledgeBase" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sources", "embedding"],
      "properties": {
        "description": { "$ref": "common.schema.json#/$defs/description" },
        "sources": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "items": { "$ref": "#/$defs/source" }
        },
        "embedding": { "$ref": "common.schema.json#/$defs/embedding" },
        "chunking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "strategy": { "enum": ["fixed", "recursive", "semantic"] },
            "size": { "type": "integer", "minimum": 64, "maximum": 8192 },
            "overlap": { "type": "integer", "minimum": 0, "maximum": 2048 }
          }
        },
        "index": {
          "type": "object",
          "additionalProperties": false,
          "required": ["provider"],
          "properties": {
            "provider": { "enum": ["sirb-managed", "pgvector", "qdrant", "pinecone"] },
            "connection": { "$ref": "common.schema.json#/$defs/secretSource" }
          },
          "if": { "properties": { "provider": { "const": "sirb-managed" } } },
          "then": { "properties": { "connection": false } },
          "else": { "required": ["connection"] }
        },
        "refresh": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schedule"],
          "properties": {
            "schedule": { "$ref": "common.schema.json#/$defs/cron" }
          }
        },
        "retrieval": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "topK": { "type": "integer", "minimum": 1, "maximum": 100 },
            "scoreThreshold": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": { "enum": ["web", "s3", "gcs", "git", "files"] },
        "web": {
          "type": "object",
          "additionalProperties": false,
          "required": ["urls"],
          "properties": {
            "urls": { "type": "array", "minItems": 1, "items": { "$ref": "common.schema.json#/$defs/httpsUrl" } },
            "crawlDepth": { "type": "integer", "minimum": 0, "maximum": 5 }
          }
        },
        "s3": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket"],
          "properties": {
            "bucket": { "type": "string", "pattern": "^[a-z0-9.-]{3,63}$" },
            "prefix": { "type": "string", "maxLength": 1024 },
            "region": { "type": "string", "pattern": "^[a-z0-9-]{1,32}$" }
          }
        },
        "gcs": {
          "type": "object",
          "additionalProperties": false,
          "required": ["bucket"],
          "properties": {
            "bucket": { "type": "string", "pattern": "^[a-z0-9._-]{3,222}$" },
            "prefix": { "type": "string", "maxLength": 1024 }
          }
        },
        "git": {
          "type": "object",
          "additionalProperties": false,
          "required": ["url"],
          "properties": {
            "url": { "$ref": "common.schema.json#/$defs/httpsUrl" },
            "branch": { "type": "string", "maxLength": 255 },
            "paths": { "type": "array", "items": { "type": "string", "maxLength": 1024 } }
          }
        },
        "files": {
          "type": "object",
          "additionalProperties": false,
          "required": ["paths"],
          "properties": {
            "paths": { "type": "array", "minItems": 1, "items": { "type": "string", "maxLength": 1024 } }
          }
        },
        "credentials": { "$ref": "common.schema.json#/$defs/secretSource" }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "web" } } },
          "then": { "required": ["web"], "properties": { "s3": false, "gcs": false, "git": false, "files": false } }
        },
        {
          "if": { "properties": { "type": { "const": "s3" } } },
          "then": { "required": ["s3"], "properties": { "web": false, "gcs": false, "git": false, "files": false } }
        },
        {
          "if": { "properties": { "type": { "const": "gcs" } } },
          "then": { "required": ["gcs"], "properties": { "web": false, "s3": false, "git": false, "files": false } }
        },
        {
          "if": { "properties": { "type": { "const": "git" } } },
          "then": { "required": ["git"], "properties": { "web": false, "s3": false, "gcs": false, "files": false } }
        },
        {
          "if": { "properties": { "type": { "const": "files" } } },
          "then": { "required": ["files"], "properties": { "web": false, "s3": false, "gcs": false, "git": false } }
        }
      ]
    }
  }
}
