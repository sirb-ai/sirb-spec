{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirb.ai/schemas/v1alpha1/uibinding.schema.json",
  "title": "Sirb UIBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "UIBinding" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target", "type"],
      "properties": {
        "target": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "name"],
          "properties": {
            "kind": { "enum": ["Agent", "Workflow"] },
            "name": { "$ref": "common.schema.json#/$defs/ref" }
          }
        },
        "type": { "enum": ["web-chat", "slack", "teams", "api"] },
        "webChat": {
          "type": "object",
          "additionalProperties": false,
          "required": ["allowedOrigins"],
          "properties": {
            "allowedOrigins": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": { "$ref": "common.schema.json#/$defs/httpsUrl" }
            },
            "greeting": { "type": "string", "maxLength": 512 },
            "theme": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "primaryColor": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
                "logoUrl": { "$ref": "common.schema.json#/$defs/httpsUrl" }
              }
            }
          }
        },
        "slack": {
          "type": "object",
          "additionalProperties": false,
          "required": ["botToken", "signingSecret"],
          "properties": {
            "botToken": { "$ref": "common.schema.json#/$defs/secretSource" },
            "signingSecret": { "$ref": "common.schema.json#/$defs/secretSource" },
            "channels": { "type": "array", "uniqueItems": true, "items": { "type": "string", "maxLength": 80 } }
          }
        },
        "teams": {
          "type": "object",
          "additionalProperties": false,
          "required": ["appId", "appPassword"],
          "properties": {
            "appId": { "type": "string", "format": "uuid" },
            "appPassword": { "$ref": "common.schema.json#/$defs/secretSource" }
          }
        },
        "api": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "rateLimitPerMinute": { "type": "integer", "minimum": 1, "maximum": 100000 }
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode"],
          "properties": {
            "mode": { "enum": ["public", "sso", "api-key"] }
          }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "web-chat" } } },
          "then": { "required": ["webChat"], "properties": { "slack": false, "teams": false, "api": false } }
        },
        {
          "if": { "properties": { "type": { "const": "slack" } } },
          "then": { "required": ["slack"], "properties": { "webChat": false, "teams": false, "api": false } }
        },
        {
          "if": { "properties": { "type": { "const": "teams" } } },
          "then": { "required": ["teams"], "properties": { "webChat": false, "slack": false, "api": false } }
        },
        {
          "if": { "properties": { "type": { "const": "api" } } },
          "then": { "properties": { "webChat": false, "slack": false, "teams": false } }
        }
      ]
    }
  }
}
