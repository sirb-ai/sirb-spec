{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirb.ai/schemas/v1alpha1/agent.schema.json",
  "title": "Sirb Agent",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": { "$ref": "common.schema.json#/$defs/apiVersion" },
    "kind": { "const": "Agent" },
    "metadata": { "$ref": "common.schema.json#/$defs/metadata" },
    "spec": { "$ref": "#/$defs/spec" }
  },
  "$defs": {
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelBinding", "instructions"],
      "properties": {
        "description": { "$ref": "common.schema.json#/$defs/description" },
        "instructions": { "type": "string", "minLength": 1, "maxLength": 32768 },
        "modelBinding": { "$ref": "common.schema.json#/$defs/ref" },
        "tools": { "$ref": "common.schema.json#/$defs/refList" },
        "memory": { "$ref": "common.schema.json#/$defs/ref" },
        "knowledgeBases": { "$ref": "common.schema.json#/$defs/refList" },
        "policies": { "$ref": "common.schema.json#/$defs/refList" },
        "maxIterations": { "type": "integer", "minimum": 1, "maximum": 100, "default": 10 },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    }
  }
}
