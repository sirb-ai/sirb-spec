{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sirb.ai/schemas/conformance/fixture.schema.json",
  "title": "Sirb conformance fixture",
  "type": "object",
  "additionalProperties": false,
  "required": ["description", "requirements", "level", "expect", "document"],
  "properties": {
    "description": { "type": "string", "minLength": 1 },
    "requirements": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^SR-SPEC-[0-9]{2}$" }
    },
    "level": { "const": "schema" },
    "expect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["valid"],
      "properties": {
        "valid": { "type": "boolean" },
        "errors": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["instancePath", "keyword"],
            "properties": {
              "instancePath": { "type": "string" },
              "keyword": { "type": "string", "minLength": 1 },
              "params": { "type": "object" }
            }
          }
        }
      },
      "if": { "properties": { "valid": { "const": false } } },
      "then": { "required": ["errors"] },
      "else": { "properties": { "errors": false } }
    },
    "document": {}
  }
}
