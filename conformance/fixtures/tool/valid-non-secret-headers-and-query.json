{
  "description": "x-session-id, keep-alive and ?country_code= are not credentials",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": true
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "geo"
    },
    "spec": {
      "type": "http",
      "description": "Look up a ticket",
      "http": {
        "method": "GET",
        "url": "https://api.example.com/v1/lookup?country_code=US&author=ada&keyword=tokens",
        "headers": {
          "x-session-id": "abc",
          "x-request-id": "r1",
          "keep-alive": "timeout=5"
        }
      }
    }
  }
}
