{
  "description": "stdio MCP tool receiving a secret through secretEnv",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": true
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "github-mcp"
    },
    "spec": {
      "type": "mcp",
      "description": "GitHub MCP server",
      "mcp": {
        "transport": "stdio",
        "command": "github-mcp-server",
        "args": [
          "stdio",
          "--read-only"
        ],
        "env": {
          "LOG_LEVEL": "info"
        },
        "secretEnv": {
          "GITHUB_PERSONAL_ACCESS_TOKEN": {
            "secretRef": {
              "name": "github-pat"
            }
          }
        }
      }
    }
  }
}
