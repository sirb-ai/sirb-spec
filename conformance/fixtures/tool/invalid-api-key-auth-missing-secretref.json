{
  "description": "api-key auth requires a secretRef",
  "requirements": [
    "SR-SPEC-03"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/http/auth",
        "keyword": "required",
        "params": {
          "missingProperty": "secretRef"
        }
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "ticket-lookup"
    },
    "spec": {
      "type": "http",
      "description": "x",
      "http": {
        "method": "GET",
        "url": "https://api.example.com",
        "auth": {
          "type": "api-key",
          "in": "header",
          "name": "x-api-key"
        }
      }
    }
  }
}
