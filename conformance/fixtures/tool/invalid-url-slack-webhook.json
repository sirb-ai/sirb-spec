{
  "description": "webhook URLs whose path is the secret are rejected",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/http/url",
        "keyword": "not"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "notify"
    },
    "spec": {
      "type": "http",
      "description": "Look up a ticket",
      "http": {
        "method": "POST",
        "url": "https://hooks.slack.com/services/T0FAKE/B0FAKE/FAKEFAKEFAKE"
      }
    }
  }
}
