{
  "description": "bearer auth forbids OAuth fields",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/http/auth/clientSecret",
        "keyword": "false"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "ticket-lookup"
    },
    "spec": {
      "type": "http",
      "description": "Look up a ticket",
      "http": {
        "method": "GET",
        "url": "https://api.example.com/tickets",
        "auth": {
          "type": "bearer",
          "credentials": {
            "secretRef": {
              "name": "a"
            }
          },
          "clientSecret": {
            "secretRef": {
              "name": "b"
            }
          }
        }
      }
    }
  }
}
