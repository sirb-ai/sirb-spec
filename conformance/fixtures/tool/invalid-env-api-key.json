{
  "description": "secret-looking env var names must use secretEnv",
  "requirements": [
    "SR-SPEC-03"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/mcp/env",
        "keyword": "propertyNames",
        "params": {
          "propertyName": "OPENAI_API_KEY"
        }
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "search-mcp"
    },
    "spec": {
      "type": "mcp",
      "description": "x",
      "mcp": {
        "transport": "stdio",
        "command": "search-mcp",
        "env": {
          "OPENAI_API_KEY": "placeholder"
        }
      }
    }
  }
}
