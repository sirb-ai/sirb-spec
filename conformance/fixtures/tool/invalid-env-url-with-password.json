{
  "description": "env values cannot be URLs with embedded credentials",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/mcp/env/DATABASE_URL",
        "keyword": "not"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "search-mcp"
    },
    "spec": {
      "type": "mcp",
      "description": "Search MCP server",
      "mcp": {
        "transport": "stdio",
        "command": "search-mcp",
        "env": {
          "DATABASE_URL": "postgres://app:FAKEpw@db:5432/app"
        }
      }
    }
  }
}
