{
  "description": "link-local (cloud metadata) addresses are rejected",
  "requirements": [
    "SR-SPEC-01"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/http/url",
        "keyword": "not"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "ticket-lookup"
    },
    "spec": {
      "type": "http",
      "description": "Look up a ticket",
      "http": {
        "method": "GET",
        "url": "https://169.254.169.254/latest/meta-data"
      }
    }
  }
}
