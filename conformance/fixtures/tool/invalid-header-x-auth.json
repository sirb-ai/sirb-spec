{
  "description": "x-auth is a credential header",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/http/headers",
        "keyword": "not",
        "property": "x-auth"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "ticket-lookup"
    },
    "spec": {
      "type": "http",
      "description": "Look up a ticket",
      "http": {
        "method": "GET",
        "url": "https://api.example.com/tickets",
        "headers": {
          "x-auth": "placeholder"
        }
      }
    }
  }
}
