{
  "description": "OAuth2 client-credentials auth with clientSecret via secretRef",
  "requirements": [
    "SR-SPEC-01",
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": true
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "crm"
    },
    "spec": {
      "type": "http",
      "description": "Look up a ticket",
      "http": {
        "method": "POST",
        "url": "https://crm.example.com/api/notes",
        "auth": {
          "type": "oauth2-client-credentials",
          "tokenUrl": "https://login.example.com/oauth2/token",
          "clientId": "sirb-crm-client",
          "clientSecret": {
            "secretRef": {
              "name": "crm-oauth"
            }
          },
          "scopes": [
            "notes.write"
          ]
        }
      }
    }
  }
}
