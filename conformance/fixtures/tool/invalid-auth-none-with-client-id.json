{
  "description": "auth type none forbids every other auth field",
  "requirements": [
    "SR-SPEC-01"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/http/auth/clientId",
        "keyword": "false"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "ticket-lookup"
    },
    "spec": {
      "type": "http",
      "description": "Look up a ticket",
      "http": {
        "method": "GET",
        "url": "https://api.example.com/tickets",
        "auth": {
          "type": "none",
          "clientId": "x"
        }
      }
    }
  }
}
