{
  "description": "header values that look like credentials are rejected",
  "requirements": [
    "SR-SPEC-03"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/http/headers/x-trace",
        "keyword": "not"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Tool",
    "metadata": {
      "name": "ticket-lookup"
    },
    "spec": {
      "type": "http",
      "description": "x",
      "http": {
        "method": "GET",
        "url": "https://api.example.com",
        "headers": {
          "x-trace": "Bearer not-a-real-token"
        }
      }
    }
  }
}
