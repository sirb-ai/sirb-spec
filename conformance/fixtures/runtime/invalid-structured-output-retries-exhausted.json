{
  "description": "when every attempt fails (first not JSON, then missing a required field) the run ends with structured-output-invalid after maxRetries retries and the agent span records the error",
  "requirements": ["SR-RT-03", "SR-RT-06"],
  "level": "runtime",
  "documents": [
    {
      "apiVersion": "sirb/v1alpha1",
      "kind": "Agent",
      "metadata": { "name": "order-classifier" },
      "spec": {
        "modelBinding": "fixture-model",
        "instructions": "Classify the customer's message."
      }
    },
    {
      "apiVersion": "sirb/v1alpha1",
      "kind": "ModelBinding",
      "metadata": { "name": "fixture-model" },
      "spec": {
        "provider": "anthropic",
        "model": "claude-sonnet-5-5",
        "mode": "byok",
        "credentials": { "secretRef": { "name": "fixture-model-key", "key": "api-key" } }
      }
    }
  ],
  "agent": "order-classifier",
  "model": {
    "turns": [
      {
        "text": "I think this is about a refund.",
        "usage": { "inputTokens": 60, "outputTokens": 9 }
      },
      {
        "expectRequest": {
          "messagesInclude": [
            { "role": "user", "text": "My parcel arrived damaged and I want my money back." },
            { "role": "assistant", "text": "I think this is about a refund." },
            { "role": "user" }
          ]
        },
        "object": { "category": "refund" },
        "usage": { "inputTokens": 105, "outputTokens": 8 }
      }
    ]
  },
  "runs": [
    {
      "input": "My parcel arrived damaged and I want my money back.",
      "structuredOutput": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["category", "urgent"],
          "properties": {
            "category": { "enum": ["refund", "delivery", "other"] },
            "urgent": { "type": "boolean" }
          }
        },
        "maxRetries": 1
      }
    }
  ],
  "expect": {
    "valid": false,
    "errors": [{ "code": "structured-output-invalid", "run": 0 }],
    "runs": [
      {
        "steps": [
          { "type": "model", "turn": 0 },
          { "type": "retry", "reason": "structured-output-invalid", "attempt": 1 },
          { "type": "model", "turn": 1 }
        ]
      }
    ],
    "spans": [
      {
        "name": "invoke_agent order-classifier",
        "status": "error",
        "attributes": { "gen_ai.operation.name": "invoke_agent", "gen_ai.agent.name": "order-classifier", "error.type": "structured-output-invalid" }
      },
      { "name": "chat claude-sonnet-5-5", "parent": 0, "attributes": { "gen_ai.operation.name": "chat", "gen_ai.usage.input_tokens": 60, "gen_ai.usage.output_tokens": 9 } },
      { "name": "chat claude-sonnet-5-5", "parent": 0, "attributes": { "gen_ai.operation.name": "chat", "gen_ai.usage.input_tokens": 105, "gen_ai.usage.output_tokens": 8 } }
    ]
  }
}
