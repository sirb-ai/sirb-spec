{
  "description": "billable bindings must not carry customer credentials",
  "requirements": [
    "SR-SPEC-02"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/credentials",
        "keyword": "false"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "ModelBinding",
    "metadata": {
      "name": "claude-billable"
    },
    "spec": {
      "provider": "anthropic",
      "model": "claude-opus-5-5",
      "mode": "billable",
      "budget": {
        "currency": "USD",
        "limit": "250",
        "period": "month",
        "onExceeded": "block"
      },
      "credentials": {
        "secretRef": {
          "name": "anthropic-key"
        }
      }
    }
  }
}
