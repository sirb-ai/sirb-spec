{
  "description": "byok binding with credentials via secretRef",
  "requirements": [
    "SR-SPEC-02",
    "SR-SPEC-03"
  ],
  "level": "schema",
  "expect": {
    "valid": true
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "ModelBinding",
    "metadata": {
      "name": "claude-default"
    },
    "spec": {
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
      "mode": "byok",
      "credentials": {
        "secretRef": {
          "name": "anthropic-key",
          "key": "api-key"
        }
      },
      "parameters": {
        "temperature": 0.3,
        "maxOutputTokens": 4096
      }
    }
  }
}
