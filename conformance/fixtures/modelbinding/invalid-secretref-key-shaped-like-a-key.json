{
  "description": "secretRef.key cannot be a key-shaped string",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/credentials/secretRef/key",
        "keyword": "not"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "ModelBinding",
    "metadata": {
      "name": "claude-default"
    },
    "spec": {
      "provider": "anthropic",
      "model": "claude-sonnet-5-5",
      "mode": "byok",
      "credentials": {
        "secretRef": {
          "name": "anthropic",
          "key": "sk-ant-api03-FAKEFAKEFAKEFAKE"
        }
      }
    }
  }
}
