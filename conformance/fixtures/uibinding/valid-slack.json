{
  "description": "Slack binding with tokens via secretRef",
  "requirements": [
    "SR-SPEC-03"
  ],
  "level": "schema",
  "expect": {
    "valid": true
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "UIBinding",
    "metadata": {
      "name": "support-slack"
    },
    "spec": {
      "target": {
        "kind": "Workflow",
        "name": "nightly-triage"
      },
      "type": "slack",
      "slack": {
        "botToken": {
          "secretRef": {
            "name": "slack-bot"
          }
        },
        "signingSecret": {
          "secretRef": {
            "name": "slack-signing"
          }
        },
        "channels": [
          "support"
        ]
      }
    }
  }
}
