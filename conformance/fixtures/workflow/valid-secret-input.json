{
  "description": "secret step inputs use a secretRef",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": true
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Workflow",
    "metadata": {
      "name": "sync"
    },
    "spec": {
      "trigger": {
        "type": "manual"
      },
      "steps": [
        {
          "id": "run",
          "tool": "ticket-lookup",
          "input": {
            "apiKey": {
              "secretRef": {
                "name": "partner-api"
              }
            },
            "region": "eu-west-1"
          }
        }
      ]
    }
  }
}
