{
  "description": "git URLs cannot embed a token",
  "requirements": [
    "SR-SPEC-04"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/sources/0/git/url",
        "keyword": "pattern"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "KnowledgeBase",
    "metadata": {
      "name": "repo-docs"
    },
    "spec": {
      "sources": [
        {
          "type": "git",
          "git": {
            "url": "https://ghp_FAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKEFAKE@github.com/acme/docs"
          }
        }
      ],
      "embedding": {
        "modelBinding": "embed-default"
      }
    }
  }
}
