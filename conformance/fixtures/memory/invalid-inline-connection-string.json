{
  "description": "connection strings must not be inline",
  "requirements": [
    "SR-SPEC-03"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/store/connection",
        "keyword": "type"
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Memory",
    "metadata": {
      "name": "kv"
    },
    "spec": {
      "type": "key-value",
      "scope": "agent",
      "store": {
        "provider": "redis",
        "connection": "redis://user:placeholder@cache:6379"
      }
    }
  }
}
