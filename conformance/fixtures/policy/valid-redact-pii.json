{
  "description": "redact PII in model output and require approval for refunds",
  "requirements": [
    "SR-SPEC-01"
  ],
  "level": "schema",
  "expect": {
    "valid": true
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Policy",
    "metadata": {
      "name": "pii-redaction"
    },
    "spec": {
      "enforcement": "enforce",
      "rules": [
        {
          "id": "redact-output",
          "target": "model-output",
          "effect": "redact",
          "match": {
            "pii": [
              "email",
              "credit-card"
            ]
          }
        },
        {
          "id": "approve-refunds",
          "target": "tool-call",
          "effect": "require-approval",
          "match": {
            "tools": [
              "refund"
            ]
          },
          "approval": {
            "approvers": [
              "group:support-leads"
            ],
            "timeoutSeconds": 3600
          }
        }
      ],
      "limits": {
        "maxToolCallsPerRun": 25,
        "maxRunSeconds": 600
      }
    }
  }
}
