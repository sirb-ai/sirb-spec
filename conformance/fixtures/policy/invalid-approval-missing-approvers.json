{
  "description": "require-approval rules need an approval block",
  "requirements": [
    "SR-SPEC-01"
  ],
  "level": "schema",
  "expect": {
    "valid": false,
    "errors": [
      {
        "instancePath": "/spec/rules/0",
        "keyword": "required",
        "params": {
          "missingProperty": "approval"
        }
      }
    ]
  },
  "document": {
    "apiVersion": "sirb/v1alpha1",
    "kind": "Policy",
    "metadata": {
      "name": "refunds"
    },
    "spec": {
      "rules": [
        {
          "id": "approve",
          "target": "tool-call",
          "effect": "require-approval"
        }
      ]
    }
  }
}
